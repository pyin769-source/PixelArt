{
  "schemaVersion": 1,
  "id": "woolmapart",
  "version": "${version}",
  "name": "PixelArt",
  "description": "Turns images into Minecraft pixel-art canvases, maps, and survival-painted artwork.",
  "environment": "*",
  "entrypoints": {
    "main": ["com.example.woolmapart.WoolMapArt"],
    "client": ["com.example.woolmapart.WoolMapArtClient"]
  },
  "mixins": [
    {
      "config": "woolmapart.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": { "fabricloader": ">=0.20.1", "minecraft": "~26.3", "java": ">=25", "fabric-api": "*" }
}
